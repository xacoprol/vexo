# Copia a .env y ajusta los valores
# Neon Free: https://console.neon.tech/signup (sin tarjeta)

# URL con pooler (hostname lleva -pooler) — la usa la app en Vercel
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# URL directa (sin -pooler) — la usa prisma migrate
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require"

AUTH_SECRET="genera-un-secreto-largo-aleatorio"
AUTH_URL="http://localhost:3000"

CRON_SECRET="secreto-para-el-endpoint-cron"

# Shopify (opcional; también en Ajustes). Desde 2026: Dev Dashboard → Client ID/Secret
# https://dev.shopify.com/dashboard — app con scope read_orders, instalada en la tienda
# SHOPIFY_SHOP="tu-tienda.myshopify.com"
# SHOPIFY_CLIENT_ID="…"
# SHOPIFY_CLIENT_SECRET="…"
# Legacy (apps admin antiguas): SHOPIFY_ADMIN_ACCESS_TOKEN="shpat_…"

SEED_EMAIL="admin@factura.local"
SEED_PASSWORD="admin123"

# Vercel Blob privado — archivo documental fiscal (PDF/Excel gestoría)
# Crea un Blob Store con Access = Private y marca
# “Add a read-write token env var”. Necesitas:
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_…"
# (en Vercel también BLOB_STORE_ID si usas OIDC)
#
# Los archivos NO son públicos: se sirven vía /api/fiscal/documents/[id]
# solo con sesión iniciada.

# Gemini — OCR de facturas de gasto y modelos presentados
# GEMINI_API_KEY="…"
# Alternativas aceptadas: GOOGLE_API_KEY o GOOGLE_GENERATIVE_AI_API_KEY
# Opcional: GEMINI_MODEL="gemini-2.0-flash"

# Veri*Factu remisión (opcional; panel en /fiscal/verifactu)
# Sin endpoint → stub de aceptación en TEST. Certificado NUNCA en git.
# VERIFACTU_AEAT_ENDPOINT="https://tu-gateway/verifactu"
# VERIFACTU_AEAT_TOKEN="…"
# VERIFACTU_AEAT_STUB="1"

# Envío de presupuestos/facturas por correo — IONOS (España)
# Usuario = email completo del buzón; contraseña = la del webmail IONOS
SMTP_HOST="smtp.ionos.es"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="facturacion@tudominio.com"
SMTP_PASS="tu-contraseña-del-buzon"
SMTP_FROM="facturacion@tudominio.com"
# Alternativa: SMTP_HOST=smtp.ionos.com · puerto 465 con SMTP_SECURE=true
# SMTP_FROM debe ser el mismo email (o alias) con el que autenticas

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Neon: URL con -pooler para la app; DIRECT_URL sin pooler para migraciones
  directUrl = env("DIRECT_URL")
}

// ─── Auth ───────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ─── Company / settings ─────────────────────────────────────────────────────

model CompanySettings {
  id              String   @id @default(cuid())
  name            String   @default("") // Nombre / razón social (fiscal)
  companyName     String   @default("") // Nombre comercial / empresa (p. ej. autónomos)
  nif             String   @default("")
  addressStreet   String   @default("")
  addressCity     String   @default("")
  addressProvince String   @default("")
  addressZip      String   @default("")
  addressCountry  String   @default("España")
  email           String   @default("")
  phone           String   @default("")
  logoUrl         String?
  defaultVatRate  Float    @default(21)
  defaultIrpfRate Float    @default(15)
  /** Régimen IRPF autónomo: 130 estimación directa | 131 módulos */
  fiscalRegime    String   @default("130")
  emailSubject    String   @default("Documento {{number}} de {{company}}")
  emailBody       String   @default("Adjuntamos el documento {{number}}.\n\nUn saludo,\n{{company}}")
  bankIban        String?
  bankName        String?
  bizumPhone      String?  @default("603024030")

  // Recordatorios de cobro
  reminderEnabled    Boolean @default(false)
  reminderDaysBefore Int     @default(3)
  reminderOnOverdue  Boolean @default(true)
  reminderSubject    String  @default("Recordatorio: factura {{number}} pendiente")
  reminderBody       String  @default("Hola {{contact}},\n\nLe recordamos que la factura {{number}} por {{remaining}} vence el {{dueDate}}.\n\nUn saludo,\n{{company}}")

  // Recordatorios fiscales (modelos AEAT)
  fiscalReminderEnabled Boolean @default(true)
  /// Destino; si vacío usa email de la empresa
  fiscalReminderEmail   String  @default("")

  // Shopify Admin API (ingresos marketplace) — Dev Dashboard 2026+
  shopifyShop          String? // tienda.myshopify.com
  shopifyClientId      String? // Client ID de la app
  shopifyClientSecret  String? // Client secret
  /** Legacy: token fijo shpat_ (apps antiguas). Si hay client id/secret se ignora. */
  shopifyAccessToken   String?
  shopifyLastSyncAt    DateTime?

  /**
   * Veri*Factu: NO_VERIFACTU = QR no verificable sin remisión;
   * VERIFACTU = cola de remisión activa (pruebas o prod según verifactuEnv).
   */
  verifactuMode String @default("NO_VERIFACTU")
  /** TEST | PROD — entorno de remisión AEAT */
  verifactuEnv  String @default("TEST")

  // UX theme (CSS variables)
  themeBg           String @default("#F3F1F8")
  themeBgElevated   String @default("#FFFFFF")
  themeInk          String @default("#1A1528")
  themeInkMuted     String @default("#6B6578")
  themeLine         String @default("#E2DEEA")
  themeAccent       String @default("#7B2CFE")
  themeAccentHover  String @default("#6518E0")
  themeAccentSoft   String @default("#EFE8FF")
  themeSidebar      String @default("#17122A")
  themeSidebarText  String @default("#EDE9F6")

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ─── Numbering series ───────────────────────────────────────────────────────

model InvoiceSeries {
  id          String    @id @default(cuid())
  prefix      String    @unique // e.g. "A-", "B-"
  name        String
  nextNumber  Int       @default(1)
  year        Int? // optional year segment; null = continuous
  padLength   Int       @default(3)
  isDefault   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  invoices    Invoice[]
}

model QuoteSeries {
  id         String  @id @default(cuid())
  prefix     String  @unique // e.g. "PRE-"
  name       String
  nextNumber Int     @default(1)
  year       Int?
  padLength  Int     @default(3)
  isDefault  Boolean @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  quotes     Quote[]
}

// ─── Clients ────────────────────────────────────────────────────────────────

model Client {
  id              String   @id @default(cuid())
  name            String
  nif             String // free-text tax id; validated loosely by countryCode
  countryCode     String   @default("ES") // ISO 3166-1 alpha-2 (ES, PT, …)
  addressStreet   String
  addressCity     String
  addressProvince String
  addressZip      String
  addressCountry  String   @default("España")
  email           String?
  phone           String?
  contactPerson   String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  quotes              Quote[]
  invoices            Invoice[]
  recurringTemplates  RecurringInvoiceTemplate[]

  @@index([name])
  @@index([nif])
  @@index([countryCode])
}

// ─── Quotes ─────────────────────────────────────────────────────────────────

model Quote {
  id            String      @id @default(cuid())
  seriesId      String
  series        QuoteSeries @relation(fields: [seriesId], references: [id])
  seriesPrefix  String
  number        Int
  fullNumber    String // e.g. PRE-2026-001
  clientId      String
  client        Client      @relation(fields: [clientId], references: [id])
  issueDate     DateTime
  validUntil    DateTime?
  status        String      @default("BORRADOR") // BORRADOR | ENVIADO | ACEPTADO | RECHAZADO | EXPIRADO
  isProforma    Boolean     @default(false) // PDF/email as Proforma (same data, not a fiscal invoice)
  notes         String?
  conditions    String?
  discountPct   Float       @default(0) // descuento general % sobre base imponible
  subtotal      Decimal
  vatAmount     Decimal
  total         Decimal
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  lines    QuoteLine[]
  invoice  Invoice?

  recurringTemplateId String?
  recurringTemplate   RecurringInvoiceTemplate? @relation(fields: [recurringTemplateId], references: [id], onDelete: SetNull)

  @@unique([seriesId, number])
  @@index([clientId])
  @@index([status])
  @@index([issueDate])
  @@index([recurringTemplateId])
}

model QuoteLine {
  id          String  @id @default(cuid())
  quoteId     String
  quote       Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  sortOrder   Int     @default(0)
  description String
  quantity    Decimal
  unitPrice   Decimal
  vatRate     Float   @default(21)
  discountPct Float   @default(0)
  lineSubtotal Decimal
  lineVat      Decimal
  lineTotal    Decimal
}

// ─── Invoices ───────────────────────────────────────────────────────────────

model Invoice {
  id            String        @id @default(cuid())
  seriesId      String
  series        InvoiceSeries @relation(fields: [seriesId], references: [id])
  seriesPrefix  String
  number        Int
  fullNumber    String // e.g. A-2026-001
  clientId      String
  client        Client        @relation(fields: [clientId], references: [id])
  issueDate     DateTime
  dueDate       DateTime?
  status        String        @default("PENDIENTE") // PENDIENTE | PAGADA | VENCIDA | ANULADA
  paymentMethod String?
  notes         String?
  subtotal      Decimal
  vatAmount     Decimal
  irpfRate      Float         @default(0)
  irpfAmount    Decimal       @default(0)
  total         Decimal

  // Fiscal / IVA classification
  vatOperationType String  @default("SUJETA") // SUJETA | EXENTA | INTRACOMUNITARIA | CANARIAS | EXPORTACION
  cashAccounting   Boolean @default(false) // criterio de caja
  operationKey     String? // clave operación (ej. modelo 303)
  operationKey347  String? // clave operación modelo 347

  quoteId String? @unique
  quote   Quote?  @relation(fields: [quoteId], references: [id])

  recurringTemplateId String?
  recurringTemplate   RecurringInvoiceTemplate? @relation(fields: [recurringTemplateId], references: [id])

  /// PDF original si se importó por OCR (histórico)
  sourceDocumentId String?
  sourceDocument   FiscalDocument? @relation("InvoiceSourceDocument", fields: [sourceDocumentId], references: [id], onDelete: SetNull)

  // Veri*Factu (RRSIF) — hash encadenado + QR; remisión AEAT pendiente
  verifactuHash          String?
  verifactuPreviousHash  String?
  verifactuRecordAt      DateTime?
  verifactuQrUrl         String?
  verifactuSentAt        DateTime?
  previousInvoiceId      String?
  previousInvoice        Invoice?  @relation("InvoiceChain", fields: [previousInvoiceId], references: [id])
  nextInChain            Invoice[] @relation("InvoiceChain")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines     InvoiceLine[]
  payments  InvoicePayment[]
  reminders InvoiceReminderLog[]
  verifactuEvents VerifactuEvent[]

  marketplaceIncome MarketplaceIncome?

  @@unique([seriesId, number])
  @@index([clientId])
  @@index([status])
  @@index([issueDate])
  @@index([recurringTemplateId])
  @@index([sourceDocumentId])
}

model InvoiceLine {
  id           String  @id @default(cuid())
  invoiceId    String
  invoice      Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  sortOrder    Int     @default(0)
  description  String
  quantity     Decimal
  unitPrice    Decimal
  vatRate      Float   @default(21)
  discountPct  Float   @default(0)
  lineSubtotal Decimal
  lineVat      Decimal
  lineTotal    Decimal
}

model InvoicePayment {
  id        String   @id @default(cuid())
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount    Decimal
  paidAt    DateTime @default(now())
  method    String?
  notes     String?
  createdAt DateTime @default(now())

  @@index([invoiceId])
  @@index([paidAt])
}

model InvoiceReminderLog {
  id        String   @id @default(cuid())
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  sentAt    DateTime @default(now())
  kind      String // MANUAL | BEFORE_DUE | OVERDUE

  @@index([invoiceId])
  @@index([sentAt])
  @@index([kind])
}

// ─── Veri*Factu events (cola remisión AEAT) ─────────────────────────────────

model VerifactuEvent {
  id            String    @id @default(cuid())
  invoiceId     String
  invoice       Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  /// ALTA | ANULACION
  kind          String
  /// PENDING | SENT | ACCEPTED | REJECTED | SKIPPED
  status        String    @default("PENDING")
  hash          String?
  previousHash  String?
  canonical     String?   @db.Text
  qrUrl         String?
  aeatCode      String?
  aeatMessage   String?   @db.Text
  attempts      Int       @default(0)
  lastAttemptAt DateTime?
  acceptedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([invoiceId])
  @@index([status])
  @@index([kind])
  @@index([createdAt])
}

// ─── Catalog of reusable line items ─────────────────────────────────────────

model CatalogItem {
  id                 String   @id @default(cuid())
  name               String
  description        String
  unitPrice          Decimal  @default(0)
  vatRate            Float    @default(21)
  defaultDiscountPct Float    @default(0)
  active             Boolean  @default(true)
  sortOrder          Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([name])
  @@index([active])
}

// ─── Fiscal: facturas recibidas / gastos ─────────────────────────────────────

model Expense {
  id             String   @id @default(cuid())
  issueDate      DateTime
  supplierName   String
  supplierNif    String?
  invoiceNumber  String?  // nº factura del proveedor (detectar duplicados)
  description    String?
  category       String   @default("OTROS") // SUMINISTROS | SOFTWARE | MATERIAL | DIETAS | PROFESIONALES | OTROS
  /// INTERIOR = compra España; INTRACOMUNITARIA = AIB UE (303 casillas 10/11 y 36/37); SERVICIO_EXTRACOMUNITARIO = servicios EEUU/terceros países (303 casillas 16/17 y 29)
  vatOperationType String @default("INTERIOR")
  subtotal       Decimal
  vatRate        Float    @default(21)
  vatAmount      Decimal
  total          Decimal
  deductible     Boolean  @default(true) // IVA deducible / gasto computable 130
  /// Si true: IVA interior → casillas 30/31; crea/actualiza InvestmentAsset
  isInvestment   Boolean  @default(false)
  notes          String?
  /// PDF/imagen/CSV original subido (Vercel Blob vía FiscalDocument)
  documentId     String?
  document       FiscalDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  investmentAssetId String? @unique
  investmentAsset   InvestmentAsset? @relation(fields: [investmentAssetId], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([issueDate])
  @@index([category])
  @@index([supplierName])
  @@index([invoiceNumber])
  @@index([documentId])
  @@index([isInvestment])
}

// ─── Fiscal: archivo documental (Vercel Blob) ────────────────────────────────

model FiscalDocument {
  id             String   @id @default(cuid())
  /// FILING | BOOK | CENSUS | PAYMENT | AEAT | IRPF | EXPENSE | INVOICE_SOURCE | INCOME | OTHER
  category       String
  title          String
  year           Int?
  quarter        Int?
  modelType      String?
  blobUrl        String
  pathname       String
  mimeType       String
  size           Int
  sourceFileName String
  notes          String?
  filingId       String?
  filing         FiscalFiling? @relation(fields: [filingId], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  taxPayments        TaxPayment[]
  aeatCommunications AeatCommunication[]
  registerBooks      RegisterBook[]
  investmentAssets   InvestmentAsset[]
  expenses           Expense[]
  sourceInvoices     Invoice[]           @relation("InvoiceSourceDocument")
  marketplaceIncomes MarketplaceIncome[]

  @@index([category])
  @@index([year, quarter])
  @@index([modelType])
  @@index([filingId])
}

// ─── Fiscal: modelos presentados (gestoría / AEAT) ───────────────────────────

model FiscalFiling {
  id             String    @id @default(cuid())
  /// Unique key e.g. "303:2026:1" | "130:2026:2" | "390:2025" | "347:2025" | "349:2026:2" | "036:2024"
  periodKey      String    @unique
  modelType      String // 303 | 130 | 390 | 347 | 349 | 036
  year           Int
  quarter        Int? // 1–4; null for annual (390/347) or census (036)
  filedAt        DateTime?
  result         Decimal   @default(0) // resultado a ingresar / clave
  /// Totales oficiales del modelo (histórico ingresos/gastos)
  incomeBase     Decimal?
  expensesBase   Decimal?
  vatRepercutida Decimal?
  vatDeductible  Decimal?
  boxes          Json // [{ code, label, value }]
  rawExtract     Json?
  sourceFileName String?
  notes          String?
  confidence     String    @default("medium") // high | medium | low
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  documents  FiscalDocument[]
  taxPayments TaxPayment[]

  @@index([modelType, year])
  @@index([year, quarter])
}

// ─── Fiscal: libros registro ─────────────────────────────────────────────────

model RegisterBook {
  id         String   @id @default(cuid())
  /// INGRESOS | GASTOS | BIENES
  bookType   String
  year       Int
  documentId String?
  document   FiscalDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  sourceFile String?
  importedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  lines RegisterBookLine[]

  @@unique([bookType, year])
  @@index([year])
}

model RegisterBookLine {
  id          String       @id @default(cuid())
  bookId      String
  book        RegisterBook @relation(fields: [bookId], references: [id], onDelete: Cascade)
  sortOrder   Int          @default(0)
  reference   String?
  invoiceNumber String?
  issueDate   DateTime?
  concept     String?
  nif         String?
  counterparty String?
  base        Decimal      @default(0)
  vatRate     Float        @default(0)
  vatAmount   Decimal      @default(0)
  withholding Decimal      @default(0)
  total       Decimal      @default(0)

  @@index([bookId])
  @@index([issueDate])
}

// ─── Fiscal: bienes de inversión + amortizaciones ───────────────────────────

model InvestmentAsset {
  id              String   @id @default(cuid())
  description     String
  supplierName    String?
  supplierNif     String?
  invoiceNumber   String?
  purchaseDate    DateTime?
  base            Decimal  @default(0)
  vatAmount       Decimal  @default(0)
  /// INTERIOR → 303 casillas 30/31; INTRACOMUNITARIA → solo amortización (AIB va en el gasto)
  vatOperationType String  @default("INTERIOR")
  usefulLifeYears Int      @default(4)
  method          String   @default("LINEAL")
  startYear       Int?
  notes           String?
  documentId      String?
  document        FiscalDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  amortizations InvestmentAmortization[]
  expense       Expense?

  @@index([purchaseDate])
  @@index([startYear])
}

model InvestmentAmortization {
  id      String          @id @default(cuid())
  assetId String
  asset   InvestmentAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  year    Int
  amount  Decimal
  notes   String?

  @@unique([assetId, year])
  @@index([year])
}

// ─── Fiscal: liquidaciones / pagos AEAT ─────────────────────────────────────

model TaxPayment {
  id         String   @id @default(cuid())
  modelType  String?
  year       Int?
  quarter    Int?
  amount     Decimal  @default(0)
  paidAt     DateTime?
  nrc        String?
  status     String   @default("PAGADO") // PAGADO | PENDIENTE | DEVUELTO
  filingId   String?
  filing     FiscalFiling? @relation(fields: [filingId], references: [id], onDelete: SetNull)
  documentId String?
  document   FiscalDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([year, quarter])
  @@index([modelType])
  @@index([paidAt])
  @@index([filingId])
  @@index([status])
}

// ─── Fiscal: comunicaciones AEAT ─────────────────────────────────────────────

model AeatCommunication {
  id          String    @id @default(cuid())
  occurredAt  DateTime  @default(now())
  /// NOTIFICACION | REQUERIMIENTO | COMUNICACION | OTRO
  kind        String    @default("COMUNICACION")
  subject     String
  summary     String?
  /// Plazo de respuesta (DEHú / requerimiento)
  dueAt       DateTime?
  /// ABIERTA | RESPONDIDA | CERRADA
  status      String    @default("ABIERTA")
  respondedAt DateTime?
  documentId  String?
  document    FiscalDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([occurredAt])
  @@index([kind])
  @@index([dueAt])
  @@index([status])
}

// ─── Fiscal: log de emails de plazo ──────────────────────────────────────────

model FiscalReminderLog {
  id        String   @id @default(cuid())
  /// e.g. 303:2026:3 | 390:2025
  periodKey String
  /// 14d | 3d | due
  kind      String
  toEmail   String
  subject   String
  sentAt    DateTime @default(now())

  @@unique([periodKey, kind])
  @@index([sentAt])
}

// ─── Fiscal: ingresos marketplace (Amazon / Shopify) ─────────────────────────

model MarketplaceIncome {
  id              String   @id @default(cuid())
  channel         String // AMAZON | SHOPIFY
  issueDate       DateTime
  externalKey     String // unique per channel (dedupe import)
  externalRef     String? // VAT Invoice Number / ref externa
  orderId         String?
  sku             String?
  description     String?
  transactionType String // SHIPMENT | RETURN | REFUND | …
  vatStatus       String // TAXABLE | EXEMPT | MARKETPLACE_COLLECTED
  vatRate         Float    @default(0)
  subtotal        Decimal // base sin IVA (puede ser negativa)
  vatAmount       Decimal
  total           Decimal
  shipToCountry   String?
  sourceFile      String?
  /// CSV/PDF/imagen original del import
  documentId      String?
  document        FiscalDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  notes           String?
  /// Factura W3D generada desde este ingreso (evita doble cómputo fiscal)
  invoiceId       String?  @unique
  invoice         Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  convertedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([channel, externalKey])
  @@index([issueDate])
  @@index([channel])
  @@index([vatStatus])
  @@index([externalRef])
  @@index([documentId])
  @@index([invoiceId])
}

// ─── Recurring invoices ─────────────────────────────────────────────────────

model RecurringInvoiceTemplate {
  id           String    @id @default(cuid())
  name         String
  clientId     String
  client       Client    @relation(fields: [clientId], references: [id])
  seriesId     String
  frequency    String // MENSUAL | TRIMESTRAL | SEMESTRAL | ANUAL
  intervalCount Int      @default(1) // repetir cada N unidades (ej. cada 1 año)
  dayOfMonth   Int       @default(1)
  startDate    DateTime
  endDate      DateTime? // fechaHasta — opcional; plantillas largas OK (solo genera la debida en cada cron)
  status       String    @default("ACTIVA") // ACTIVA | PAUSADA | FINALIZADA
  notes        String?
  paymentMethod String?
  bankIban     String?
  irpfRate     Float     @default(0)
  vatOperationType String  @default("SUJETA") // SUJETA | EXENTA | INTRACOMUNITARIA | CANARIAS | EXPORTACION
  cashAccounting   Boolean @default(false)
  operationKey     String?
  operationKey347  String?
  nextRunDate  DateTime? // única factura pendiente; no se pregeneran futuras
  lastRunAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  lines    RecurringLine[]
  invoices Invoice[]
  quotes   Quote[]

  @@index([status])
  @@index([nextRunDate])
  @@index([clientId])
}

model RecurringLine {
  id           String                   @id @default(cuid())
  templateId   String
  template     RecurringInvoiceTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  sortOrder    Int                      @default(0)
  description  String
  quantity     Decimal
  unitPrice    Decimal
  vatRate      Float                    @default(21)
  discountPct  Float                    @default(0)
}

model CronRunLog {
  id               String   @id @default(cuid())
  startedAt        DateTime @default(now())
  finishedAt       DateTime?
  success          Boolean  @default(false)
  templatesChecked Int      @default(0)
  invoicesCreated  Int      @default(0)
  details          String? // JSON string for SQLite/Postgres portability
  error            String?
}
